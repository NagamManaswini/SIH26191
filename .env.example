# Application Settings
APP_NAME="Intelligent Disaster Management Platform"
APP_ENV=production
DEBUG=false

# Security & JWT Token Authentication
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_256_BIT_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# API Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=YOUR_PASSWORD
DB_NAME=YOUR_DATABASE_NAME

# Data Pipeline Paths & API Endpoints
DATASET_DIR=./data/raw
PROCESSED_DIR=./data/processed
OPEN_METEO_API=https://api.open-meteo.com/v1/forecast
ISRO_BHUVAN_WMS=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Google Maps & Places API Keys
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Live Weather API Settings
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

